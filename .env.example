# Google Analytics 4 Measurement ID (public, safe to expose client-side).
# The Property ID is intentionally NOT included here — it is only used
# server-side by the Dashboard's Analytics Data API integration (future work).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-MTC6NFKFVY

# Public Supabase project configuration. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-project-service-role-key
